student_names    = []   # str   - student's full name
student_ids      = []   # int   - unique student ID (1001, 1002...)
student_count    = 0    # int   - counter to generate student IDs

# Rigid Institutional Grading Scheme Setup
# Total Course Grade = (Lecture * 70%) + (Laboratory * 30%)
category_names = [
    "Lec - Class Standing", # 70% Course * 60% Component = 42% Total
    "Lec - Midterm Exam",   # 70% Course * 15% Component = 10.5% Total
    "Lec - Final Exam",     # 70% Course * 25% Component = 17.5% Total
    "Lab - Class Standing", # 30% Course * 60% Component = 18% Total
    "Lab - Midterm Exam",   # 30% Course * 15% Component = 4.5% Total
    "Lab - Final Exam"      # 30% Course * 25% Component = 7.5% Total
]

category_weights = [0.42, 0.105, 0.175, 0.18, 0.045, 0.075]

# Flat transaction/grade logs
grade_student_ids = []  # int   - links to student_ids
grade_categories  = []  # str   - links to category_names
grade_scores      = []  # float - the numeric score (0.0 to 100.0)


