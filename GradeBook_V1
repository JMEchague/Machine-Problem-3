# ============================================================
#   HELPER FUNCTIONS
# ============================================================

def print_line():
    print("------------------------------------------------")


def print_header(title):
    print()
    print("================================================")
    print("  " + title)
    print("================================================")


def get_float_input(prompt):
    while True:
        raw = input(prompt)
        try:
            value = float(raw)
            if value < 0 or value > 100:
                print("  Error: Score must be between 0 and 100. Try again.")
            else:
                return value
        except ValueError:
            print("  Error: '" + raw + "' is not a valid number. Try again.")


def get_student_id():
    while True:
        raw = input("  Enter Student ID number: ")
        try:
            number = int(raw)
            return number
        except ValueError:
            print("  Error: Student ID must be a whole number.")


def is_valid_student(student_id):
    index = student_id - 1001
    if index >= 0 and index < len(student_names):
        return True
    else:
        return False


def get_student_index(student_id):
    return student_id - 1001


def get_status_and_letter(score):
    # Enforces the mandatory 70 passing raw score threshold
    if score >= 90.0:
        return "PASSED", "A"
    elif score >= 80.0:
        return "PASSED", "B"
    elif score >= 70.0:
        return "PASSED", "C"
    else:
        return "FAILED", "F"


def calculate_component_avg(student_id, prefix):
    # Calculates isolated averages for either "Lec" or "Lab" components
    # Normalized to standard 100% scale internally based on syllabus weights (60%, 15%, 25%)
    cs_sum = 0.0;  cs_count = 0
    me_sum = 0.0;  me_count = 0
    fe_sum = 0.0;  fe_count = 0

    g = 0
    while g < len(grade_student_ids):
        if grade_student_ids[g] == student_id:
            if grade_categories[g] == (prefix + " - Class Standing"):
                cs_sum = cs_sum + grade_scores[g]
                cs_count = cs_count + 1
            elif grade_categories[g] == (prefix + " - Midterm Exam"):
                me_sum = me_sum + grade_scores[g]
                me_count = me_count + 1
            elif grade_categories[g] == (prefix + " - Final Exam"):
                fe_sum = fe_sum + grade_scores[g]
                fe_count = fe_count + 1
        g = g + 1

    # Fallback default values to 0 if no structural evaluations are logged yet
    cs_avg = (cs_sum / cs_count) if cs_count > 0 else 0.0
    me_avg = (me_sum / me_count) if me_count > 0 else 0.0
    fe_avg = (fe_sum / fe_count) if fe_count > 0 else 0.0

    # Apply standard distribution weights: 60% CS, 15% ME, 25% FE
    return (cs_avg * 0.60) + (me_avg * 0.15) + (fe_avg * 0.25)


def calculate_student_final(student_id):
    # Computes final institutional composite score: 70% Lecture + 30% Laboratory
    if len(grade_student_ids) == 0:
        return -1.0
        
    lec_grade = calculate_component_avg(student_id, "Lec")
    lab_grade = calculate_component_avg(student_id, "Lab")
    
    return (lec_grade * 0.70) + (lab_grade * 0.30)


