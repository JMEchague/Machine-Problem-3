# ── 3. Enter Grade (Upgraded with Choice Loop & Exit) ────────

def enter_grade():
    print_header("Enter Student Grades")

    if len(student_names) == 0:
        print("  Error: No students registered yet.")
        return

    student_id = get_student_id()
    if is_valid_student(student_id) == False:
        print("  Error: Student ID " + str(student_id) + " does not exist.")
        return

    s_index = get_student_index(student_id)
    print("  Recording entry mode for student: " + student_names[s_index])

    # Continuous grade loop block 
    grading_active = True
    while grading_active == True:
        print_line()
        print("  Select Target Evaluation Subcategory:")
        i = 0
        while i < len(category_names):
            print("  " + str(i + 1) + " - " + category_names[i])
            i = i + 1
        print("  0 - Finish & Exit to Main Menu")
        print_line()
        
        cat_choice = input("  Select option (0-6): ")
        
        if cat_choice == "0":
            print()
            print("  Returning to main configuration engine...")
            grading_active = False
        else:
            try:
                cat_idx = int(cat_choice) - 1
                if cat_idx < 0 or cat_idx >= len(category_names):
                    print("  Error: Invalid assignment index. Select 0 to 6.")
                else:
                    selected_category = category_names[cat_idx]
                    score = get_float_input("  Enter raw score (0.0 - 100.0) for [" + selected_category + "]: ")

                    # Log entry instantly to parallel tracking storage arrays
                    grade_student_ids.append(student_id)
                    grade_categories.append(selected_category)
                    grade_scores.append(score)

                    print()
                    print("  ✔  Grade saved successfully!")
                    print("  [" + student_names[s_index] + " -> " + selected_category + " -> " + str(score) + "]")
            except ValueError:
                print("  Error: Please input a clean matching whole number choice (0-6).")


# ── 4. Generate Report Card ──────────────────────────────────

def generate_report_card():
    print_header("Generate Report Card")

    if len(student_names) == 0:
        print("  No students found.")
        return

    student_id = get_student_id()
    if is_valid_student(student_id) == False:
        print("  Error: Student ID " + str(student_id) + " does not exist.")
        return

    s_index = get_student_index(student_id)
    
    lec_grade = calculate_component_avg(student_id, "Lec")
    lab_grade = calculate_component_avg(student_id, "Lab")
    final_score = calculate_student_final(student_id)

    print()
    print_line()
    print("                  STUDENT REPORT CARD           ")
    print_line()
    print("  Student ID   : " + str(student_id))
    print("  Student Name : " + student_names[s_index])
    print_line()
    print("  COMPONENT PERFORMANCE:")
    print("  - Lecture Component (70%)    : " + str(round(lec_grade, 2)) + "%")
    print("  - Laboratory Component (30%) : " + str(round(lab_grade, 2)) + "%")
    print_line()
    
    if final_score >= 0:
        status, letter = get_status_and_letter(final_score)
        print("  FINAL UNIFIED RAW SCORE      : " + str(round(final_score, 2)) + "%")
        print("  COURSE OUTCOME STATUS        : " + status)
        print_line()
        print("  * TRANSCRIPT SYLLABUS ENTRIES:")
        print("    Lecture Transcript Grade   : " + letter)
        print("    Laboratory Transcript Grade: " + letter)
        print("    (Grades match per academic policy directive)")
    else:
        print("  FINAL WEIGHTED SCORE         : No scores recorded.")
    print_line()


# ── 5. View Grade Statistics & Distribution ──────────────────

def view_stats():
    print_header("Class Grade Distribution & Stats")

    if len(student_names) == 0:
        print("  No student records present.")
        return

    total_sum = 0.0
    graded_students_count = 0

    count_passed = 0
    count_failed = 0

    i = 0
    while i < len(student_ids):
        f_score = calculate_student_final(student_ids[i])
        if f_score >= 0:
            total_sum = total_sum + f_score
            graded_students_count = graded_students_count + 1
            
            status, letter = get_status_and_letter(f_score)
            if status == "PASSED":
                count_passed = count_passed + 1
            else:
                count_failed = count_failed + 1
        i = i + 1

    if graded_students_count == 0:
        print("  No grading metrics recorded to compile data from.")
        return

    class_average = total_sum / graded_students_count

    print_line()
    print("  OVERALL PERFORMANCE SUMMARY")
    print_line()
    print("  Total Evaluated Students : " + str(graded_students_count))
    print("  Overall Class Average     : " + str(round(class_average, 2)) + "%")
    print("  Passing Raw Score Criteria: 70.0%")
    print_line()
    print("  OUTCOME DISTRIBUTION MATRIX")
    print_line()
    print("  PASSED (>= 70) : " + str(count_passed).ljust(5) + " (" + str(round((count_passed/graded_students_count)*100, 1)) + "%)")
    print("  FAILED (< 70)  : " + str(count_failed).ljust(5) + " (" + str(round((count_failed/graded_students_count)*100, 1)) + "%)")
    print_line()


# ── 6. View All Students ─────────────────────────────────────

def view_all_students():
    print_header("All Registered Students")

    if len(student_names) == 0:
        print("  No student records exist.")
        return

    print_line()
    print("  No.    Student ID    Student Name          Final Grade Status")
    print_line()

    i = 0
    while i < len(student_names):
        student_id = 1001 + i
        number_str  = str(i + 1) + "."
        id_str      = str(student_id)
        name_str    = student_names[i]
        
        final_score = calculate_student_final(student_id)
        if final_score >= 0:
            status, letter = get_status_and_letter(final_score)
            grade_str = str(round(final_score, 1)) + "% (" + letter + ") - " + status
        else:
            grade_str = "UNGRADED"

        print("  " + number_str.ljust(6) + id_str.ljust(14) + name_str.ljust(22) + grade_str)
        i = i + 1

    print_line()
    print("  Total Students: " + str(len(student_names)))
    print_line()


