account_names    = []   # str  - owner's name
account_types    = []   # str  - "Savings" or "Checking"
account_balances = []   # float - current balance

# Transaction history stored as plain strings
transaction_log  = []   # list of str messages

# Account counter used to make simple account numbers
account_count = 0


