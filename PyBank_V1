# ============================================================
#   HELPER FUNCTIONS
# ============================================================

def print_line():
    # Prints a divider line
    print("------------------------------------------------")


def print_header(title):
    # Prints a section header
    print()
    print("================================================")
    print("  " + title)
    print("================================================")


def get_float_input(prompt):
    # Asks the user for a number and returns it as a float.
    # Keeps asking until the user enters a valid positive number.
    while True:
        raw = input(prompt)
        # Check if the input is a valid number
        try:
            value = float(raw)
            if value < 0:
                print("  Error: Amount cannot be negative. Try again.")
            else:
                return value
        except ValueError:
            print("  Error: '" + raw + "' is not a valid number. Try again.")


def get_account_number():
    # Asks the user for an account number and returns it as an integer.
    while True:
        raw = input("  Enter account number: ")
        try:
            number = int(raw)
            return number
        except ValueError:
            print("  Error: Account number must be a whole number.")


def is_valid_account(account_number):
    # Returns True if the account number exists, False otherwise.
    # Account numbers start at 1001
    index = account_number - 1001
    if index >= 0 and index < len(account_names):
        return True
    else:
        return False


def get_index(account_number):
    # Converts account number to list index
    return account_number - 1001


def add_to_log(message):
    # Adds a transaction message to the log
    transaction_log.append(message)


