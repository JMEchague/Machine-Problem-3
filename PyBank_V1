# ============================================================
#   ENTRY POINT - main() function
# ============================================================

def main():
    # Show the welcome banner when the program starts
    show_banner()

    # Main program loop - keeps running until user chooses 0
    running = True

    while running == True:
        show_menu()
        choice = input("  Enter your choice: ")

        # Route to the correct function based on user choice
        if choice == "1":
            create_account()

        elif choice == "2":
            deposit()

        elif choice == "3":
            withdraw()

        elif choice == "4":
            transfer()

        elif choice == "5":
            apply_interest()

        elif choice == "6":
            check_balance()

        elif choice == "7":
            show_history()

        elif choice == "8":
            view_all_accounts()

        elif choice == "0":
            print()
            print("  ╔════════════════════════════════════════╗")
            print("  ║  Thank you for using PyBank!           ║")
            print("  ║  Have a great day!                     ║")
            print("  ╚════════════════════════════════════════╝")
            print()
            running = False

        else:
            print()
            print("  Error: '" + choice + "' is not a valid option.")
            print("  Please enter a number from 0 to 8.")

        # Pause before showing the menu again
        if running == True:
            print()
            input("  Press Enter to return to the main menu...")


# ── Run the program ──────────────────────────────────────────
main()
